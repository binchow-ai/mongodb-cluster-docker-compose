services:
  ## Router
  router01:
    image: mongodb/mongodb-community-server:8.2-ubi8
    container_name: router-01
    ports:
      - "27017:27017"
    restart: always
    volumes:
      - ./scripts:/scripts
      - ./data/mongos01:/data
    entrypoint: ["/scripts/entrypoint-route.sh"]

  ## Config Servers 
  configsvr01:
    image: mongodb/mongodb-community-server:8.2-ubi8
    container_name: mongo-config-01
    volumes:
      - ./scripts:/scripts
      - /home/ec2-user/mongodb-cluster-docker-compose/data/configsvr01:/data
    restart: always
    entrypoint: ["/scripts/entrypoint-configserver.sh"]

  configsvr02:
    image: mongodb/mongodb-community-server:8.2-ubi8
    container_name: mongo-config-02
    command: mongod --port 27017 --configsvr --replSet rs-config-server
    volumes:
      - ./scripts:/scripts
      - /home/ec2-user/mongodb-cluster-docker-compose/data/configsvr02:/data
    restart: always

  configsvr03:
    image: mongodb/mongodb-community-server:8.2-ubi8
    container_name: mongo-config-03
    command: mongod --port 27017 --configsvr --replSet rs-config-server
    volumes:
      - ./scripts:/scripts
      - /home/ec2-user/mongodb-cluster-docker-compose/data/configsvr03:/data
    restart: always

  ## Shards
  shard01-a:
    image: mongodb/mongodb-community-server:8.2-ubi8
    container_name: shard-01-node-a
    volumes:
      - ./scripts:/scripts
      - ./data/shard01_a:/data
    restart: always
    entrypoint: ["/bin/sh", "/scripts/entrypoint-shard01.sh"]

  shard01-b:
    image: mongodb/mongodb-community-server:8.2-ubi8
    container_name: shard-01-node-b
    command: mongod --port 27017 --shardsvr --replSet rs-shard-01
    volumes:
      - ./scripts:/scripts
      - ./data/shard01_b:/data
    restart: always

  shard01-c:
    image: mongodb/mongodb-community-server:8.2-ubi8
    container_name: shard-01-node-c
    command: mongod --port 27017 --shardsvr --replSet rs-shard-01
    volumes:
      - ./scripts:/scripts
      - ./data/shard01_c:/data
    restart: always

  shard02-a:
    image: mongodb/mongodb-community-server:8.2-ubi8
    container_name: shard-02-node-a
    volumes:
      - ./scripts:/scripts
      - ./data/shard02_a:/data
    restart: always
    entrypoint: ["/bin/sh", "/scripts/entrypoint-shard02.sh"]

  shard02-b:
    image: mongodb/mongodb-community-server:8.2-ubi8
    container_name: shard-02-node-b
    command: mongod --port 27017 --shardsvr --replSet rs-shard-02
    volumes:
      - ./scripts:/scripts
      - ./data/shard02_b:/data
    restart: always

  shard02-c:
    image: mongodb/mongodb-community-server:8.2-ubi8
    container_name: shard-02-node-c
    command: mongod --port 27017 --shardsvr --replSet rs-shard-02
    volumes:
      - ./scripts:/scripts
      - ./data/shard02_c:/data
    restart: always

  